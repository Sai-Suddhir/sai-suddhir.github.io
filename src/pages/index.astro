---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CircuitBoard from '../components/CircuitBoard.astro';
import Todo from '../components/Todo.astro';
import profilePhoto from '../assets/profile.jpg';
import {
  isTodo, profile, about, publications, research, projects, industry,
  teaching, coursework, tools, contact,
} from '../data/content';
import type { WorkItem } from '../data/content';

const assets = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{png,jpg,jpeg,webp}', { eager: true });
const img = (name?: string) => (name ? assets[`../assets/${name}`]?.default : undefined);

// keep trailing initials together (e.g. 'A B') so they never wrap apart
const nameWords = profile.name.replace(/((?:\s[A-Z]\.?)+)$/, (m) => ' ' + m.trim().replace(/\s/g, ' ')).split(' ');

// **bold** → <strong>
const md = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');

const workGroups: { label: string; items: WorkItem[] }[] = [
  { label: 'Research', items: research },
  { label: 'Projects', items: projects },
  { label: 'Industry', items: industry },
];
---
<Base>
  <!-- ───────── Home ───────── -->
  <section class="hero" id="top">
    <CircuitBoard />
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="status hero-fade" style="--h:0"><span class="status-dot" aria-hidden="true"></span>{profile.status}</p>
        <h1 class="hero-title">
          {nameWords.map((w, i) => (
            <span class="word"><span style={`--h:${i + 1}`}>{w}</span></span>
          ))}
        </h1>
        <p class="hero-focus hero-fade" style="--h:3">{profile.focus}</p>
        <p class="hero-lead hero-fade" style="--h:4">{profile.tagline}</p>
        <div class="hero-actions hero-fade" style="--h:5">
          <a class="btn btn-primary" href={profile.links.cv} target="_blank" rel="noopener">
            <Icon name="download" size={16} /> Download CV
          </a>
          <a class="btn" href="#contact">
            <Icon name="mail" size={16} /> Get in touch
          </a>
          <span class="hero-social">
            <a href={profile.links.github} target="_blank" rel="noopener" aria-label="GitHub"><Icon name="github" size={19} /></a>
            <a href={profile.links.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin" size={19} /></a>
            {!isTodo(profile.links.scholar) && <a href={profile.links.scholar} target="_blank" rel="noopener" aria-label="Google Scholar"><Icon name="scholar" size={19} /></a>}
          </span>
        </div>
      </div>

      <aside class="now-wrap hero-fade" style="--h:6" aria-label="Currently">
        <div class="now-card">
          <div class="now-head">
            <Image class="now-avatar" src={profilePhoto} alt="" widths={[96, 192]} sizes="64px" loading="eager" />
            <div>
              <p class="now-name">{profile.name}</p>
              <p class="now-sub">{profile.institution} · {profile.location}</p>
            </div>
          </div>
          <p class="now-label">Now</p>
          <ul class="now-list">
            {profile.now.map((n) => (
              <li><a href={n.href}><span class="now-key">{n.label}</span><span>{n.text}</span></a></li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
    <a href="#about" class="scroll-cue hero-fade" style="--h:7" aria-label="Scroll to About">
      <span>Scroll</span><i></i>
    </a>
  </section>

  <!-- ───────── About ───────── -->
  <section class="section" id="about">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">About</span>
        <h2 class="section-title">Hello, I'm Sai.</h2>
      </div>
      <div class="about-grid">
        <figure class="portrait" data-reveal>
          <Image src={profilePhoto} alt={`Portrait of ${profile.name}`} widths={[360, 560, 720]} sizes="(max-width: 760px) 100vw, 300px" />
          {isTodo(profile.photoNote) && <figcaption><Todo text={profile.photoNote} /></figcaption>}
        </figure>
        <div class="about-body">
          {about.bio.map((p, i) => <p class="about-p" data-reveal style={`--d:${i * 90}ms`} set:html={md(p)} />)}

          <h3 class="mini-head" data-reveal>Interests</h3>
          <ul class="chips" data-stagger="50">
            {about.interests.map((x) => <li data-reveal>{x}</li>)}
          </ul>

          <h3 class="mini-head" data-reveal>Education</h3>
          <ul class="edu" data-stagger="90">
            {about.education.map((e) => (
              <li data-reveal>
                <div>
                  <p class="edu-school">{e.school}</p>
                  <p class="edu-degree">{e.degree}</p>
                </div>
                <div class="edu-meta">
                  <span>{e.period}</span>
                  {e.detail && <span class="edu-detail">{e.detail}</span>}
                </div>
              </li>
            ))}
          </ul>

          <h3 class="mini-head" data-reveal>Honors &amp; leadership</h3>
          <ul class="bullets honors" data-stagger="60">
            {about.honors.map((h) => <li data-reveal>{h}</li>)}
            {about.leadership.map((l) => (
              <li data-reveal>
                <strong>{l.role}</strong>: {l.text} {isTodo(l.period) ? <Todo text={l.period} /> : <span class="period">({l.period})</span>}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────── Work ───────── -->
  <section class="section" id="work">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Work</span>
        <h2 class="section-title">Research &amp; projects</h2>
        <p class="section-sub">Click any item to see the details.</p>
      </div>

      <h3 class="mini-head" data-reveal>Publication</h3>
      {publications.map((p) => (
        <article class="pub card" data-reveal>
          <h4 class="pub-title">{p.title}</h4>
          <p class="pub-authors" set:html={p.authors} />
          <p class="pub-venue">{p.venue}</p>
        </article>
      ))}

      {workGroups.map((g) => (
        <>
          <h3 class="mini-head" data-reveal>{g.label}</h3>
          <div class="rows" data-stagger="60">
            {g.items.map((it) => {
              const src = img(it.image);
              const metaParts = it.meta.split(' · ');
              return (
                <details class="row" id={`work-${it.id}`} data-reveal>
                  <summary>
                    <span class="row-main">
                      <span class="row-title">{it.title}</span>
                      <span class="row-one">{it.oneLiner}</span>
                    </span>
                    <span class="row-meta">
                      {metaParts.map((m, i) => (
                        isTodo(m) ? <Todo text={m} /> : <span>{i > 0 && ' · '}{m}</span>
                      ))}
                    </span>
                    <span class="row-icon" aria-hidden="true"></span>
                  </summary>
                  <div class="row-body">
                    <div class="row-inner">
                      {it.advisor && (isTodo(it.advisor)
                        ? <p class="advisor">Advisor: <Todo text={it.advisor} /></p>
                        : <p class="advisor">Advisor: {it.advisor}, IIT Madras</p>)}
                      <div class:list={['row-content', { 'has-media': !!src }]}>
                        <ul class="bullets">{it.points.map((pt) => <li>{pt}</li>)}</ul>
                        {src && (
                          <figure class="row-media">
                            <Image src={src} alt={it.imageAlt ?? ''} widths={[400, 700]} sizes="(max-width: 760px) 100vw, 340px" />
                          </figure>
                        )}
                      </div>
                      <div class="tag-list">{it.tags.map((t) => <span class="tag">{t}</span>)}</div>
                    </div>
                  </div>
                </details>
              );
            })}
          </div>
        </>
      ))}
    </div>
  </section>

  <!-- ───────── Academics ───────── -->
  <section class="section" id="academics">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Academics</span>
        <h2 class="section-title">Coursework &amp; teaching</h2>
      </div>
      <div class="kit">
        <div>
          <h3 class="mini-head" data-reveal>Key coursework</h3>
          <dl class="kit-list" data-stagger="70">
            {coursework.map((s) => (
              <div data-reveal>
                <dt>{s.group}</dt>
                <dd>
                  <ul class="courses">
                    {s.items.map((c) => (
                      <li>
                        {isTodo(c.name) ? <Todo text={c.name} /> : c.name}
                        {'grade' in c && c.grade && <span class="grade" title="Grade">{c.grade}</span>}
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))}
          </dl>
        </div>
        <div>
          <h3 class="mini-head" data-reveal>Teaching assistant</h3>
          <ul class="bullets ta" data-stagger="70">
            {teaching.map((t) => <li data-reveal>{t}</li>)}
          </ul>
          <h3 class="mini-head" data-reveal>Tools</h3>
          <dl class="kit-list" data-stagger="70">
            {tools.map((s) => (
              <div data-reveal>
                <dt>{s.group}</dt>
                <dd>{s.items}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────── CV ───────── -->
  <section class="section" id="cv">
    <div class="container">
      <div class="cv-band card" data-reveal>
        <div>
          <span class="eyebrow">CV</span>
          <h2 class="cv-title">Curriculum Vitae</h2>
          <p class="cv-text">Everything above, on one page.</p>
        </div>
        <div class="cv-actions">
          <a class="btn" href={profile.links.cv} target="_blank" rel="noopener"><Icon name="arrow" size={16} /> View</a>
          <a class="btn btn-primary" href={profile.links.cv} download="Sai_Suddhir_AB_CV.pdf"><Icon name="download" size={16} /> Download PDF</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────── Contact ───────── -->
  <section class="section contact" id="contact">
    <div class="container">
      <div class="contact-card" data-reveal>
        <span class="eyebrow">Contact</span>
        <h2 class="contact-title">Let's talk.</h2>
        <p class="contact-text">{contact}</p>
        <a class="contact-mail" href={`mailto:${profile.email}`}>
          {profile.email}
          <Icon name="arrow" size={22} />
        </a>
        <div class="contact-links">
          <a class="btn" href={profile.links.github} target="_blank" rel="noopener"><Icon name="github" size={16} /> GitHub</a>
          <a class="btn" href={profile.links.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" size={16} /> LinkedIn</a>
          {!isTodo(profile.links.scholar) && <a class="btn" href={profile.links.scholar} target="_blank" rel="noopener"><Icon name="scholar" size={16} /> Scholar</a>}
          {isTodo(profile.links.scholar) && <Todo text={profile.links.scholar} />}
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 112px 0 120px;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: -20% -10% auto auto;
    width: 60vw;
    height: 60vw;
    max-width: 760px;
    max-height: 760px;
    background: radial-gradient(closest-side, var(--accent-soft), transparent 70%);
    filter: blur(10px);
    animation: drift 18s ease-in-out infinite alternate;
    pointer-events: none;
  }
  @keyframes drift { to { transform: translate(-8%, 10%) scale(1.08); } }
  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 330px;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 6px 14px 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg-elev) 75%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-size: 13px;
    color: var(--ink-2);
  }
  .status-dot { position: relative; width: 8px; height: 8px; border-radius: 50%; background: #2fa66a; flex: none; }
  .status-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #2fa66a;
    animation: ping 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes ping { 75%, 100% { transform: scale(2.6); opacity: 0; } }

  .hero-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(44px, 6vw, 88px);
    line-height: 0.98;
    letter-spacing: -0.035em;
    margin: 22px 0 14px;
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.24em;
  }
  .word { display: inline-block; overflow: hidden; padding-bottom: 0.08em; margin-bottom: -0.08em; }
  .word > span {
    display: inline-block;
    transform: translateY(105%);
    animation: rise 1.1s var(--ease) forwards;
    animation-delay: calc(0.15s + var(--h) * 0.09s);
  }
  .hero-fade {
    opacity: 0;
    transform: translateY(12px);
    animation: fade-up 1s var(--ease) forwards;
    animation-delay: calc(0.15s + var(--h) * 0.1s);
  }
  @keyframes rise { to { transform: none; } }
  @keyframes fade-up { to { opacity: 1; transform: none; } }

  .hero-focus {
    font-family: var(--mono);
    font-size: 12.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 22px;
  }
  .hero-lead {
    max-width: 600px;
    font-size: clamp(17px, 1.9vw, 20px);
    line-height: 1.6;
    color: var(--ink-2);
    margin-bottom: 34px;
  }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .hero-social { display: inline-flex; gap: 4px; margin-left: 6px; }
  .hero-social a {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    color: var(--ink-2);
    transition: color 0.3s, background-color 0.3s, transform 0.4s var(--ease);
  }
  .hero-social a:hover { color: var(--accent); background: var(--accent-soft); transform: translateY(-2px); }

  /* profile card */
  .now-wrap.hero-fade {
    animation-name: fade-up, float;
    animation-duration: 1s, 7s;
    animation-timing-function: var(--ease), ease-in-out;
    animation-delay: calc(0.15s + var(--h) * 0.1s), 1.4s;
    animation-iteration-count: 1, infinite;
    animation-direction: normal, alternate;
    animation-fill-mode: forwards, none;
  }
  @keyframes float { from { transform: translateY(0); } to { transform: translateY(-8px); } }
  .now-card {
    padding: 22px 22px 14px;
    border-radius: 20px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg-elev) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    box-shadow: var(--shadow-hover);
    transition: transform 0.6s var(--ease), border-color 0.4s;
  }
  .now-card:hover { transform: translateY(-4px); border-color: var(--line-strong); }
  .now-head { display: flex; align-items: center; gap: 14px; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
  .now-head :global(.now-avatar) {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 62%;
    box-shadow: 0 0 0 3px var(--bg-elev), 0 0 0 4px var(--accent);
  }
  .now-name { margin: 0; font-weight: 600; font-size: 15.5px; letter-spacing: -0.01em; }
  .now-sub { margin: 0; color: var(--muted); font-size: 13px; }
  .now-label {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 16px 0 6px;
  }
  .now-list a {
    display: grid;
    grid-template-columns: 58px 1fr;
    gap: 10px;
    font-size: 14px;
    line-height: 1.45;
    padding: 8px 8px;
    margin: 0 -8px;
    border-radius: 10px;
    color: var(--ink-2);
    transition: background-color 0.3s, color 0.3s;
  }
  .now-list a:hover { background: var(--accent-soft); color: var(--ink); }
  .now-key { font-family: var(--mono); font-size: 11.5px; color: var(--accent); padding-top: 2px; }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14.5px;
    font-weight: 500;
    padding: 11px 18px;
    border-radius: 12px;
    border: 1px solid var(--line-strong);
    background: var(--bg-elev);
    color: var(--ink);
    transition: transform 0.4s var(--ease), border-color 0.3s, color 0.3s, background-color 0.3s, box-shadow 0.4s var(--ease);
  }
  .btn:hover { transform: translateY(-2px); border-color: var(--accent); color: var(--accent); box-shadow: var(--shadow); }
  .btn-primary { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .btn-primary:hover { background: var(--accent); border-color: var(--accent); color: #fff; }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 22px;
    translate: -50% 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    z-index: 1;
  }
  .scroll-cue i { width: 1px; height: 34px; background: var(--line-strong); position: relative; overflow: hidden; }
  .scroll-cue i::after {
    content: '';
    position: absolute;
    left: 0;
    top: -40%;
    width: 1px;
    height: 40%;
    background: var(--accent);
    animation: cue 2.2s var(--ease) infinite;
  }
  @keyframes cue { to { top: 100%; } }

  /* ── Section bits ── */
  .section-sub { margin: 4px 0 0; color: var(--muted); font-size: 15px; }
  .mini-head {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 36px 0 14px;
  }
  .period { font-family: var(--mono); font-size: 12.5px; color: var(--muted); }

  /* ── About ── */
  .about-grid { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: clamp(32px, 6vw, 72px); align-items: start; }
  .portrait {
    margin: 0;
    border-radius: 18px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--line);
    position: sticky;
    top: 96px;
  }
  .portrait :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 62%; transition: transform 1.2s var(--ease); }
  .portrait:hover :global(img) { transform: scale(1.03); }
  .portrait figcaption { position: absolute; left: 10px; right: 10px; bottom: 10px; }
  .about-p { font-size: 18px; line-height: 1.75; color: var(--ink-2); max-width: 640px; }
  .about-p :global(strong) { color: var(--ink); font-weight: 600; }
  .about-body > .about-p:first-child { margin-top: 0; }

  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li {
    font-size: 14px;
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    transition: border-color 0.3s, color 0.3s, transform 0.9s var(--ease), opacity 0.9s var(--ease);
  }
  .chips li:hover { border-color: var(--accent); color: var(--accent); }

  .edu li { display: flex; justify-content: space-between; gap: 20px; padding: 14px 0; border-top: 1px solid var(--line); }
  .edu li:last-child { border-bottom: 1px solid var(--line); }
  .edu p { margin: 0; }
  .edu-school { font-weight: 500; }
  .edu-degree { color: var(--muted); font-size: 14.5px; }
  .edu-meta { display: flex; flex-direction: column; align-items: flex-end; text-align: right; font-size: 13px; color: var(--muted); white-space: nowrap; font-family: var(--mono); }
  .edu-detail { color: var(--accent); }
  .honors li { font-size: 15.5px; }
  .honors :global(strong) { color: var(--ink); font-weight: 600; }

  /* ── Work ── */
  .pub { padding: 22px 26px; position: relative; overflow: hidden; }
  .pub::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 3px; background: var(--accent); }
  .pub-title { font-family: var(--serif); font-size: clamp(20px, 2.3vw, 24px); font-weight: 500; line-height: 1.3; margin: 0 0 8px; }
  .pub-authors { color: var(--ink-2); margin: 0 0 2px; font-size: 15px; }
  .pub-authors :global(strong) { font-weight: 600; color: var(--ink); }
  .pub-venue { font-style: italic; font-family: var(--serif); font-size: 16.5px; color: var(--muted); margin: 0; }

  .rows { display: flex; flex-direction: column; gap: 10px; }
  .row {
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color 0.35s, box-shadow 0.5s var(--ease), opacity 0.9s var(--ease), transform 0.9s var(--ease);
  }
  .row:hover { border-color: var(--line-strong); }
  .row[open] { border-color: var(--line-strong); box-shadow: var(--shadow); }
  .row summary {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 20px;
    align-items: center;
    gap: 18px;
    padding: 18px 22px;
    cursor: pointer;
  }
  .row summary::-webkit-details-marker { display: none; }
  .row-main { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .row-title { font-weight: 600; font-size: 16.5px; letter-spacing: -0.01em; transition: color 0.3s; }
  .row:hover .row-title, .row[open] .row-title { color: var(--accent); }
  .row-one { color: var(--muted); font-size: 14.5px; }
