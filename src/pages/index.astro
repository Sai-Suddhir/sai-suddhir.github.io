---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Phasor from '../components/Phasor.astro';
import Todo from '../components/Todo.astro';
import TileArt from '../components/TileArt.astro';
import profilePhoto from '../assets/profile.jpg';
import {
  isTodo, profile, intro, about, publications, teaching, coursework, tools, contact,
} from '../data/content';
import { getWork, GROUPS } from '../lib/work';

const work = await getWork();
const workGroups = GROUPS.map((g) => ({ key: g.key, label: g.label, items: work.filter((w) => w.data.group === g.key) })).filter((g) => g.items.length);
// The first project with a cover image gets a wide, featured card.
const featuredId = work.find((w) => w.data.group === 'projects' && w.data.cover)?.id;

// Name split into words → letters (for the focus-in animation).
// Trailing initials ("A B") stay together so they never wrap apart.
const nameWords = profile.name
  .replace(/((?:\s[A-Z]\.?)+)$/, (m) => ' ' + m.trim().replace(/\s/g, '\u00a0'))
  .split(' ');
let letterIndex = 0;
const nameLetters = nameWords.map((w) => Array.from(w).map((ch) => ({ ch, i: letterIndex++ })));

// **bold** → <strong>
const md = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');

---
<Base>
  <!-- ───────── Home: name, quote, photo, who I am ───────── -->
  <section class="intro" id="top">
    <div class="intro-top">
      <Phasor />
      <div class="container intro-head">
        <h1 class="name" aria-label={profile.name}>
          {nameLetters.map((word) => (
            <span class="name-word" aria-hidden="true">
              {word.map(({ ch, i }) => <span class="ch" style={`--i:${i}`}>{ch}</span>)}
            </span>
          ))}
        </h1>
        <figure class="quote fade" style="--h:0">
          <blockquote>{intro.quote.text}</blockquote>
          {intro.quote.by && <figcaption>{intro.quote.by}</figcaption>}
        </figure>
      </div>
    </div>

    <div class="container intro-body" id="about">
      <figure class="me">
        <span class="me-frame">
          <span class="me-drift" data-parallax="14">
            <Image src={profilePhoto} alt={`Photo of ${profile.name}`} widths={[360, 560, 760]} sizes="(max-width: 760px) 80vw, 340px" loading="eager" />
          </span>
        </span>
      </figure>
      <div class="intro-text">
        {intro.paragraphs.map((p, i) => <p class="fade" style={`--h:${2 + i}`} set:html={md(p)} />)}
        <div class="intro-actions fade" style="--h:4">
          <a class="btn btn-primary" href={profile.links.cv} target="_blank" rel="noopener">
            <Icon name="download" size={16} /> Download CV
          </a>
          <a class="btn" href="#contact">
            <Icon name="mail" size={16} /> Get in touch
          </a>
          <span class="intro-social">
            <a href={profile.links.github} target="_blank" rel="noopener" aria-label="GitHub"><Icon name="github" size={19} /></a>
            <a href={profile.links.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin" size={19} /></a>
            {!isTodo(profile.links.scholar) && <a href={profile.links.scholar} target="_blank" rel="noopener" aria-label="Google Scholar"><Icon name="scholar" size={19} /></a>}
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────── Background: education, interests, honors ───────── -->
  <section class="section" id="background">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Background</span>
        <h2 class="section-title" data-split>A little more about me</h2>
      </div>
      <div class="bg-grid">
        <div>
          <h3 class="mini-head" data-reveal>Education</h3>
          <ul class="edu" data-stagger="90">
            {about.education.map((e) => (
              <li class="rule-in" data-reveal>
                <div>
                  <p class="edu-school">{e.school}</p>
                  <p class="edu-degree">{e.degree}</p>
                </div>
                <div class="edu-meta">
                  <span>{e.period}</span>
                  {e.detail && <span class="edu-detail">{e.detail}</span>}
                </div>
              </li>
            ))}
          </ul>

          <h3 class="mini-head" data-reveal>Honors &amp; leadership</h3>
          <ul class="bullets honors" data-stagger="60">
            {about.honors.map((h) => <li data-reveal>{h}</li>)}
            {about.leadership.map((l) => (
              <li data-reveal>
                <strong>{l.role}</strong>: {l.text} {isTodo(l.period) ? <Todo text={l.period} /> : <span class="period">({l.period})</span>}
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h3 class="mini-head" data-reveal>Interests</h3>
          <div class="interests">
            <div data-reveal>
              <p class="int-label">In engineering</p>
              <ul class="chips" data-stagger="50">
                {about.interests.engineering.map((x) => <li data-reveal>{x}</li>)}
              </ul>
            </div>
            <div data-reveal>
              <p class="int-label">Outside it</p>
              <ul class="chips chips-soft" data-stagger="50">
                {about.interests.life.map((x) => <li data-reveal>{x}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────── Work ───────── -->
  <section class="section" id="work">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Work</span>
        <h2 class="section-title" data-split>Research &amp; projects</h2>
        <p class="section-sub">Pick any card to open its full page, with images, documents and code.</p>
      </div>

      <h3 class="mini-head" data-reveal>Publication</h3>
      {publications.map((p) => (
        <article class="pub card" data-reveal data-glow>
          <h4 class="pub-title">{p.title}</h4>
          <p class="pub-authors" set:html={p.authors} />
          <p class="pub-venue">{p.venue}</p>
          {(p.pdf || p.page) && (
            <div class="pub-links">
              {p.pdf && <a class="pub-btn" href={p.pdf} target="_blank" rel="noopener"><span class="pub-pdf">PDF</span> Read the digest</a>}
              {p.page && <a class="pub-btn" href={p.page}>Figures &amp; results <Icon name="arrow" size={14} /></a>}
            </div>
          )}
        </article>
      ))}

      {workGroups.map((g) => (
        <>
          <h3 class="mini-head" data-reveal>{g.label}</h3>
          {g.key === 'course' ? (
            <ul class="rows" data-stagger="70">
              {g.items.map((w) => (
                <li data-reveal class="rule-in">
                  <a class="row" href={`/work/${w.id}/`} data-glow>
                    <span class="row-title" style={`view-transition-name: work-${w.id}`}>{w.data.title}</span>
                    <span class="row-one">{w.data.oneLiner}</span>
                    <span class="row-meta">{w.data.role}</span>
                    <span class="row-arrow" aria-hidden="true"><Icon name="arrow" size={16} /></span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <div class={`tiles tiles-${g.key}`} style={`--cols:${Math.max(1, Math.min(3, g.items.filter((w) => w.id !== featuredId).length))}`} data-stagger="90">
              {g.items.map((w) => {
                const d = w.data;
                const meta = [d.role, d.period].filter((m) => m && !isTodo(m)).join(' · ');
                const featured = w.id === featuredId;
                const thumb = d.cover ?? d.gallery[0]?.src; // fall back to the first gallery image
                return (
                  <a class:list={['tile', { 'tile-featured': featured }]} href={`/work/${w.id}/`} data-reveal data-glow>
                    <span class:list={['tile-media', { 'tile-media-logo': d.logo }]} data-curtain>
                      {d.logo
                        ? <span class="tile-logo"><Image src={d.logo} alt={d.org ?? d.title} width={640} /></span>
                        : thumb
                        ? <Image src={thumb} alt="" widths={featured ? [600, 900, 1200] : [400, 640]} sizes={featured ? '(max-width: 900px) 100vw, 640px' : '(max-width: 600px) 100vw, (max-width: 900px) 50vw, 360px'} />
                        : <TileArt id={w.id} title={d.title} group={d.group} />}
                    </span>
                    <span class="tile-body">
                      {meta && <span class="tile-meta">{meta}</span>}
                      <span class="tile-title" style={`view-transition-name: work-${w.id}`}>{d.title}</span>
                      <span class="tile-one">{d.oneLiner}</span>
                      <span class="tile-open">Read more <Icon name="arrow" size={14} /></span>
                    </span>
                  </a>
                );
              })}
            </div>
          )}
        </>
      ))}
    </div>
  </section>

  <!-- ───────── Academics ───────── -->
  <section class="section" id="academics">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Academics</span>
        <h2 class="section-title" data-split>Coursework &amp; teaching</h2>
      </div>
      <div class="kit">
        <div>
          <h3 class="mini-head" data-reveal>Key coursework</h3>
          <dl class="kit-list" data-stagger="70">
            {coursework.map((s) => (
              <div class="rule-in" data-reveal>
                <dt>{s.group}</dt>
                <dd>
                  <ul class="courses">
                    {s.items.map((c) => (
                      <li>
                        {isTodo(c.name) ? <Todo text={c.name} /> : c.name}
                        {'grade' in c && c.grade && <span class="grade" title="Grade">{c.grade}</span>}
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))}
          </dl>
        </div>
        <div>
          <h3 class="mini-head" data-reveal>Teaching assistant</h3>
          <ul class="bullets ta" data-stagger="70">
            {teaching.map((t) => <li data-reveal>{t}</li>)}
          </ul>
          <h3 class="mini-head" data-reveal>Tools</h3>
          <dl class="kit-list" data-stagger="70">
            {tools.map((s) => (
              <div class="rule-in" data-reveal>
                <dt>{s.group}</dt>
                <dd>{s.items}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────── CV ───────── -->
  <section class="section" id="cv">
    <div class="container">
      <div class="cv-band card" data-reveal data-glow>
        <div>
          <span class="eyebrow">CV</span>
          <h2 class="cv-title">Curriculum Vitae</h2>
          <p class="cv-text">Everything above, on one page.</p>
        </div>
        <div class="cv-actions">
          <a class="btn" href={profile.links.cv} target="_blank" rel="noopener"><Icon name="arrow" size={16} /> View</a>
          <a class="btn btn-primary" href={profile.links.cv} download="Sai_Suddhir_AB_CV.pdf"><Icon name="download" size={16} /> Download PDF</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────── Contact ───────── -->
  <section class="section contact" id="contact">
    <div class="container">
      <div class="contact-card" data-reveal data-glow>
        <span class="eyebrow">Contact</span>
        <h2 class="contact-title">Let's talk.</h2>
        <p class="contact-text">{contact}</p>
        <a class="contact-mail" href={`mailto:${profile.email}`}>
          {profile.email}
          <Icon name="arrow" size={22} />
        </a>
        <div class="contact-links">
          <a class="btn" href={profile.links.github} target="_blank" rel="noopener"><Icon name="github" size={16} /> GitHub</a>
          <a class="btn" href={profile.links.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" size={16} /> LinkedIn</a>
          {!isTodo(profile.links.scholar) && <a class="btn" href={profile.links.scholar} target="_blank" rel="noopener"><Icon name="scholar" size={16} /> Scholar</a>}
          {isTodo(profile.links.scholar) && <Todo text={profile.links.scholar} />}
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── Intro ── */
  .intro { position: relative; padding-bottom: clamp(24px, 4vw, 48px); }
  .intro-top {
    position: relative;
    padding: clamp(130px, 19vh, 190px) 0 clamp(90px, 13vh, 130px);
    overflow: hidden;
  }
  .intro-head { position: relative; z-index: 1; text-align: center; }

  .name {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(58px, 11.5vw, 156px);
    line-height: 0.95;
    letter-spacing: -0.012em;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 0.22em;
  }
  .name-word { display: inline-flex; white-space: nowrap; }
  .ch {
    display: inline-block;
    opacity: 0;
    filter: blur(12px);
    transform: translateY(0.06em) scale(1.04);
    animation: focus-in 1.4s var(--ease) forwards;
    animation-delay: calc(0.25s + var(--i) * 55ms);
  }
  @keyframes focus-in { to { opacity: 1; filter: blur(0); transform: none; } }

  .quote { margin: clamp(22px, 3.4vw, 36px) auto 0; max-width: 760px; text-wrap: balance; }
  .quote blockquote {
    margin: 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(21px, 2.7vw, 30px);
    line-height: 1.35;
    color: var(--ink-2);
  }
  .quote blockquote::before, .quote blockquote::after { color: var(--accent); }
  .quote blockquote::before { content: '“'; }
  .quote blockquote::after { content: '”'; }
  .quote figcaption { margin-top: 10px; font-size: 14px; color: var(--muted); }
  .quote figcaption::before { content: '— '; }

  .fade {
    opacity: 0;
    transform: translateY(14px);
    animation: fade-up 1.1s var(--ease) forwards;
    animation-delay: calc(1.15s + var(--h) * 0.14s);
  }
  @keyframes fade-up { to { opacity: 1; transform: none; } }

  .intro-body {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: clamp(36px, 6vw, 80px);
    align-items: center;
    max-width: 1000px;
  }
  .me { margin: 0; }
  .me-frame {
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: 22px;
    overflow: hidden;
    background: var(--line);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-hover);
  }
  .me-frame {
    clip-path: inset(100% 0 0 0 round 22px);
    animation: curtain 1.5s var(--ease) 1.25s forwards;
  }
  @keyframes curtain { to { clip-path: inset(-80px round 22px); } } /* overshoot so the shadow isn't clipped */
  .me-drift { display: block; width: 100%; height: 100%; transform: scale(1.08); will-change: transform; }
  .me-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    transform: scale(1.14);
    animation: settle 2.2s var(--ease) 1.25s forwards;
  }
  @keyframes settle { to { transform: none; } }

  .intro-text p { font-size: clamp(17px, 1.6vw, 19px); line-height: 1.8; color: var(--ink-2); margin: 0 0 1.1em; }
  .intro-text p :global(strong) { color: var(--ink); font-weight: 600; }
  .intro-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 28px; }
  .intro-social { display: inline-flex; gap: 4px; margin-left: 4px; }
  .intro-social a {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--ink-2);
    transition: color 0.3s, background-color 0.3s, transform 0.4s var(--ease);
  }
  .intro-social a:hover { color: var(--accent); background: var(--accent-soft); transform: translateY(-2px); }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14.5px;
    font-weight: 600;
    padding: 12px 20px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--bg-elev);
    color: var(--ink);
    transition: transform 0.4s var(--ease), border-color 0.3s, color 0.3s, background-color 0.3s, box-shadow 0.4s var(--ease);
  }
  .btn:hover { transform: translateY(-2px); border-color: var(--accent); color: var(--accent); box-shadow: var(--shadow); }
  .btn-primary { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .btn-primary:hover { background: var(--accent); border-color: var(--accent); color: #fff; }

  /* ── Section bits ── */
  .section-sub { margin: 4px 0 0; color: var(--muted); font-size: 15px; }
  .mini-head {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 36px 0 14px;
  }
  .period { font-family: var(--mono); font-size: 12.5px; color: var(--muted); }

  /* ── Background ── */
  .bg-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 72px); align-items: start; }
  .bg-grid > div > .mini-head:first-child { margin-top: 0; }

  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li {
    font-size: 14px;
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    transition: border-color 0.3s, color 0.3s, transform 0.9s var(--ease), opacity 0.9s var(--ease);
  }
  .chips li:hover { border-color: var(--accent); color: var(--accent); }
  .interests { display: flex; flex-direction: column; gap: 18px; }
  .int-label { margin: 0 0 8px; font-size: 13.5px; color: var(--muted); }
  .chips-soft li { background: transparent; border-style: dashed; }

  .edu li { display: flex; justify-content: space-between; gap: 20px; padding: 14px 0; border-top: 1px solid var(--line); }
  .edu li:last-child { border-bottom: 1px solid var(--line); }
  .edu p { margin: 0; }
  .edu-school { font-weight: 600; }
  .edu-degree { color: var(--muted); font-size: 14.5px; }
  .edu-meta { display: flex; flex-direction: column; align-items: flex-end; text-align: right; font-size: 13px; color: var(--muted); white-space: nowrap; font-family: var(--mono); }
  .edu-detail { color: var(--accent); }
  .honors li { font-size: 15.5px; }
  .honors :global(strong) { color: var(--ink); font-weight: 600; }

  /* ── Work ── */
  .pub { padding: 22px 26px; position: relative; overflow: hidden; }
  .pub::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 3px; background: var(--accent); }
  .pub-title { font-family: var(--serif); font-size: clamp(20px, 2.3vw, 24px); font-weight: 500; line-height: 1.3; margin: 0 0 8px; }
  .pub-authors { color: var(--ink-2); margin: 0 0 2px; font-size: 15px; }
  .pub-authors :global(strong) { font-weight: 600; color: var(--ink); }
  .pub-venue { font-style: italic; font-family: var(--serif); font-size: 16.5px; color: var(--muted); margin: 0; }
  .pub-links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  .pub-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13.5px;
    font-weight: 600;
    padding: 7px 14px 7px 8px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--ink);
    transition: border-color 0.3s, color 0.3s, translate 0.4s var(--ease);
  }
  .pub-btn:last-child { padding-left: 14px; }
  .pub-btn:hover { border-color: var(--accent); color: var(--accent); translate: 0 -1px; }
  .pub-pdf { font-family: var(--mono); font-size: 10.5px; padding: 2px 6px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); }

  .tiles { display: grid; gap: 18px; grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr)); }
  .tile {
    display: flex;
    flex-direction: column;
    border-radius: 18px;
    overflow: hidden;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    transition: border-color 0.4s, box-shadow 0.6s var(--ease), translate 0.6s var(--ease), opacity 0.9s var(--ease), transform 0.9s var(--ease);
  }
  .tile:hover { border-color: var(--line-strong); box-shadow: var(--shadow-hover); translate: 0 -4px; }
  .tile-media { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: var(--bg); border-bottom: 1px solid var(--line); }
  .tile-media :global(img), .tile-media :global(svg) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  .tile:hover .tile-media :global(img), .tile:hover .tile-media :global(svg) { transform: scale(1.05); }

  /* company logo on a clean panel instead of a photo */
  .tile-media-logo {
    display: grid;
    place-items: center;
    background:
      linear-gradient(rgba(20, 23, 28, 0.045) 1px, transparent 1px) 0 0 / 20px 20px,
      linear-gradient(90deg, rgba(20, 23, 28, 0.045) 1px, transparent 1px) 0 0 / 20px 20px,
      #fbfaf7;
  }
  .tile-logo { display: grid; place-items: center; width: 100%; height: 100%; padding: 0 18%; }
  .tile-media-logo :global(img) { width: 100%; height: auto; max-height: 34%; object-fit: contain; }
  .tile-body { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px 20px; flex: 1; }
  .tile-meta { font-family: var(--mono); font-size: 11.5px; color: var(--muted); }
  .tile-title { font-family: var(--serif); font-size: 23px; line-height: 1.15; color: var(--ink); width: fit-content; transition: color 0.3s; }
  .tile:hover .tile-title { color: var(--accent); }
  .tile-one { color: var(--ink-2); font-size: 14.5px; line-height: 1.55; flex: 1; }
  .tile-open {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
    margin-top: 12px;
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
    transition: color 0.3s, gap 0.5s var(--ease);
  }
  .tile-open :global(svg) { transition: transform 0.5s var(--ease); }
  .tile:hover .tile-open { color: var(--accent); gap: 10px; }

  /* featured: wide card, image beside text */
  .tile-featured { grid-column: 1 / -1; flex-direction: row; }
