---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Waveform from '../components/Waveform.astro';
import Todo from '../components/Todo.astro';
import profilePhoto from '../assets/profile.jpg';
import {
  isTodo, profile, about, highlights, publications, research, experience,
  featuredProjects, otherProjects, honors, skills, coursework, beyond,
} from '../data/content';

const assets = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{png,jpg,jpeg,webp}', { eager: true });
const img = (name?: string) => (name ? assets[`../assets/${name}`]?.default : undefined);

const nameWords = profile.name.split(' ');
---
<Base>
  <!-- ───────── Hero ───────── -->
  <section class="hero" id="top">
    <div class="container hero-inner">
      <p class="eyebrow hero-fade" style="--h:0">{profile.institution} · {profile.focus}</p>
      <h1 class="hero-title">
        {nameWords.map((w, i) => (
          <span class="word"><span style={`--h:${i + 1}`}>{w}</span></span>
        ))}
      </h1>
      <p class="hero-lead hero-fade" style="--h:4">{profile.tagline}</p>
      <div class="hero-actions hero-fade" style="--h:5">
        <a class="btn btn-primary" href={profile.links.cv} target="_blank" rel="noopener">
          <Icon name="download" size={16} /> Download CV
        </a>
        <a class="btn" href={`mailto:${profile.email}`}>
          <Icon name="mail" size={16} /> Get in touch
        </a>
        <span class="hero-social">
          <a href={profile.links.github} target="_blank" rel="noopener" aria-label="GitHub"><Icon name="github" size={19} /></a>
          <a href={profile.links.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin" size={19} /></a>
          {!isTodo(profile.links.scholar) && <a href={profile.links.scholar} target="_blank" rel="noopener" aria-label="Google Scholar"><Icon name="scholar" size={19} /></a>}
        </span>
        {isTodo(profile.links.scholar) && <Todo text={profile.links.scholar} />}
      </div>
    </div>
    <Waveform />
    <a href="#about" class="scroll-cue hero-fade" style="--h:7" aria-label="Scroll to About">
      <span>Scroll</span><i></i>
    </a>
  </section>

  <!-- ───────── Highlights ───────── -->
  <section class="highlights">
    <div class="container">
      <ul class="stats" data-stagger="110">
        {highlights.map((h) => (
          <li data-reveal>
            <span class="stat-num">
              {h.prefix}<span data-count={h.value} data-decimals={h.decimals}>{h.value.toFixed(h.decimals)}</span>{h.suffix}
            </span>
            <span class="stat-label">{h.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ───────── About ───────── -->
  <section class="section" id="about">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">About</span>
        <h2 class="section-title">Hello, I'm Sai.</h2>
      </div>
      <div class="about-grid">
        <figure class="portrait" data-reveal>
          <Image src={profilePhoto} alt={`Portrait of ${profile.name}`} widths={[360, 560, 720]} sizes="(max-width: 760px) 100vw, 340px" loading="eager" />
          {isTodo(profile.photoNote) && <figcaption><Todo text={profile.photoNote} /></figcaption>}
        </figure>
        <div class="about-body">
          {about.paragraphs.map((p, i) => <p class="about-p" data-reveal style={`--d:${i * 90}ms`}>{p}</p>)}

          <h3 class="mini-head" data-reveal>Research interests</h3>
          <ul class="chips" data-stagger="50">
            {about.interests.map((x) => <li data-reveal>{x}</li>)}
          </ul>

          <h3 class="mini-head" data-reveal>Education</h3>
          <ul class="edu" data-stagger="90">
            {about.education.map((e) => (
              <li data-reveal>
                <div>
                  <p class="edu-school">{e.school}</p>
                  <p class="edu-degree">{e.degree}</p>
                </div>
                <div class="edu-meta">
                  <span>{e.period}</span>
                  {e.detail && <span class="edu-detail">{e.detail}</span>}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────── Research ───────── -->
  <section class="section" id="research">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Research</span>
        <h2 class="section-title">Publications &amp; research</h2>
      </div>

      {publications.map((p) => (
        <article class="pub card" data-reveal>
          <span class="pub-status">{p.status}</span>
          <h3 class="pub-title">{p.title}</h3>
          <p class="pub-authors" set:html={p.authors} />
          <p class="pub-venue">{p.venue}</p>
          {p.summary && <p class="pub-summary">{p.summary}</p>}
        </article>
      ))}

      <div class="research-list" data-stagger="120">
        {research.map((r) => (
          <article class="research card" data-reveal>
            <span class="pub-status research-status">{r.status}</span>
            <div class="research-top">
              <h3 class="card-title">{r.title}</h3>
              {isTodo(r.period) ? <Todo text={r.period} /> : <span class="period">{r.period}</span>}
            </div>
            {isTodo(r.advisor)
              ? (import.meta.env.DEV && <p class="advisor">Advisor: <Todo text={r.advisor} /></p>)
              : <p class="advisor">Advisor: {r.advisor}, IIT Madras</p>}
            <ul class="bullets">{r.points.map((pt) => <li>{pt}</li>)}</ul>
            <div class="tag-list">{r.tags.map((t) => <span class="tag">{t}</span>)}</div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ───────── Experience ───────── -->
  <section class="section" id="experience">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Experience</span>
        <h2 class="section-title">Industry, teaching &amp; leadership</h2>
      </div>
      <ol class="timeline" data-timeline>
        {experience.map((x) => (
          <li class="tl-item" data-reveal>
            <span class="tl-dot" aria-hidden="true"></span>
            <div class="tl-head">
              <h3 class="card-title">{x.role} · <span class="org">{x.org}</span></h3>
              <span class="period">
                {isTodo(x.period) && x.period && <><Todo text={x.period} />{' '}</>}
                {[isTodo(x.period) ? '' : x.period, x.place].filter(Boolean).join(' · ')}
              </span>
            </div>
            <ul class="bullets">{x.points.map((pt) => <li>{pt}</li>)}</ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ───────── Projects ───────── -->
  <section class="section" id="projects">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Projects</span>
        <h2 class="section-title">Selected work</h2>
      </div>

      <div class="featured">
        {featuredProjects.map((p, i) => {
          const src = img(p.image);
          return (
            <article class:list={['feature', { flip: i % 2 === 1 }]}>
              {src && (
                <figure class="feature-media" data-reveal>
                  <Image src={src} alt={p.imageAlt} widths={[480, 800, 1100]} sizes="(max-width: 860px) 100vw, 540px" />
                </figure>
              )}
              <div class="feature-body" data-reveal style="--d:120ms">
                <p class="period">{p.subtitle}</p>
                <h3 class="feature-title">{p.title}</h3>
                <p class="feature-summary">{p.summary}</p>
                <ul class="bullets">{p.points.map((pt) => <li>{pt}</li>)}</ul>
                <div class="tag-list">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
              </div>
            </article>
          );
        })}
      </div>

      <h3 class="mini-head more-head" data-reveal>More projects</h3>
      <div class="more" data-stagger="100">
        {otherProjects.map((p) => (
          <article class="card more-card" data-reveal>
            <p class="period">{p.meta}</p>
            <h4 class="card-title">{p.title}</h4>
            <p class="more-text">{p.text}</p>
            <div class="tag-list">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ───────── Honors ───────── -->
  <section class="section" id="honors">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Honors</span>
        <h2 class="section-title">Awards &amp; recognition</h2>
      </div>
      <ul class="honors" data-stagger="90">
        {honors.map((h, i) => (
          <li data-reveal>
            <span class="honor-n">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <p class="honor-title">{h.title}</p>
              <p class="honor-detail">{h.detail}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ───────── Skills & coursework ───────── -->
  <section class="section" id="skills">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Toolkit</span>
        <h2 class="section-title">Skills &amp; coursework</h2>
      </div>
      <div class="kit">
        <div>
          <h3 class="mini-head" data-reveal>Technical skills</h3>
          <dl class="kit-list" data-stagger="70">
            {skills.map((s) => (
              <div data-reveal>
                <dt>{s.group}</dt>
                <dd>{s.items.join(' · ')}</dd>
              </div>
            ))}
          </dl>
        </div>
        <div>
          <h3 class="mini-head" data-reveal>Key coursework</h3>
          <dl class="kit-list" data-stagger="70">
            {coursework.map((s) => (
              <div data-reveal>
                <dt>{s.group}</dt>
                <dd>
                  <ul class="courses">
                    {s.items.map((c) => (
                      <li>
                        {isTodo(c.name) ? <Todo text={c.name} /> : c.name}
                        {'grade' in c && c.grade && <span class="grade" title="Grade">{c.grade}</span>}
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </div>

      <h3 class="mini-head beyond-head" data-reveal>Beyond the lab</h3>
      <ul class="bullets beyond" data-stagger="70">
        {beyond.map((b) => <li data-reveal>{b}</li>)}
      </ul>
    </div>
  </section>

  <!-- ───────── Contact ───────── -->
  <section class="section contact" id="contact">
    <div class="container">
      <div class="contact-card" data-reveal>
        <span class="eyebrow">Contact</span>
        <h2 class="contact-title">Let's talk research.</h2>
        <p class="contact-text">
          I'm happy to discuss power electronics, real-time control, or graduate research opportunities.
        </p>
        <a class="contact-mail" href={`mailto:${profile.email}`}>
          {profile.email}
          <Icon name="arrow" size={22} />
        </a>
        <div class="contact-links">
          <a class="btn" href={profile.links.github} target="_blank" rel="noopener"><Icon name="github" size={16} /> GitHub</a>
          <a class="btn" href={profile.links.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" size={16} /> LinkedIn</a>
          {!isTodo(profile.links.scholar) && <a class="btn" href={profile.links.scholar} target="_blank" rel="noopener"><Icon name="scholar" size={16} /> Scholar</a>}
          <a class="btn" href={profile.links.cv} target="_blank" rel="noopener"><Icon name="download" size={16} /> CV (PDF)</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    --wave-h: clamp(140px, 18vw, 250px);
    padding: 112px 0 calc(var(--wave-h) + 100px);
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: -20% -10% auto auto;
    width: 60vw;
    height: 60vw;
    max-width: 760px;
    max-height: 760px;
    background: radial-gradient(closest-side, var(--accent-soft), transparent 70%);
    filter: blur(10px);
    animation: drift 18s ease-in-out infinite alternate;
    pointer-events: none;
  }
  @keyframes drift { to { transform: translate(-8%, 10%) scale(1.08); } }
  .hero-inner { position: relative; z-index: 1; }

  .hero-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(48px, 10vw, 112px);
    line-height: 0.98;
    letter-spacing: -0.035em;
    margin: 18px 0 26px;
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.24em;
  }
  .word { display: inline-block; overflow: hidden; padding-bottom: 0.08em; margin-bottom: -0.08em; }
  .word > span {
    display: inline-block;
    transform: translateY(105%);
    animation: rise 1.1s var(--ease) forwards;
    animation-delay: calc(0.15s + var(--h) * 0.09s);
  }
  .hero-fade {
    opacity: 0;
    transform: translateY(12px);
    animation: fade-up 1s var(--ease) forwards;
    animation-delay: calc(0.15s + var(--h) * 0.1s);
  }
  @keyframes rise { to { transform: none; } }
  @keyframes fade-up { to { opacity: 1; transform: none; } }

  .hero-lead {
    max-width: 640px;
    font-size: clamp(17px, 1.9vw, 20px);
    line-height: 1.6;
    color: var(--ink-2);
    margin-bottom: 34px;
  }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .hero-social { display: inline-flex; gap: 4px; margin-left: 6px; }
  .hero-social a {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    color: var(--ink-2);
    transition: color 0.3s, background-color 0.3s, transform 0.4s var(--ease);
  }
  .hero-social a:hover { color: var(--accent); background: var(--accent-soft); transform: translateY(-2px); }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14.5px;
    font-weight: 500;
    padding: 11px 18px;
    border-radius: 12px;
    border: 1px solid var(--line-strong);
    background: var(--bg-elev);
    color: var(--ink);
    transition: transform 0.4s var(--ease), border-color 0.3s, color 0.3s, background-color 0.3s, box-shadow 0.4s var(--ease);
  }
  .btn:hover { transform: translateY(-2px); border-color: var(--accent); color: var(--accent); box-shadow: var(--shadow); }
  .btn-primary { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .btn-primary:hover { background: var(--accent); border-color: var(--accent); color: #fff; }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 22px;
    translate: -50% 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    z-index: 1;
  }
  .scroll-cue i { width: 1px; height: 34px; background: var(--line-strong); position: relative; overflow: hidden; }
  .scroll-cue i::after {
    content: '';
    position: absolute;
    left: 0;
    top: -40%;
    width: 1px;
    height: 40%;
    background: var(--accent);
    animation: cue 2.2s var(--ease) infinite;
  }
  @keyframes cue { to { top: 100%; } }

  /* ── Highlights ── */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .stats li { padding: 28px 22px 26px; border-left: 1px solid var(--line); }
  .stats li:first-child { border-left: 0; padding-left: 0; }
  .stat-num {
    display: block;
    font-family: var(--serif);
    font-size: clamp(36px, 4.4vw, 50px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 10px;
    font-variant-numeric: tabular-nums;
  }
  .stat-label { display: block; font-size: 13.5px; line-height: 1.5; color: var(--muted); max-width: 230px; }

  /* ── About ── */
  .about-grid { display: grid; grid-template-columns: 300px 1fr; gap: clamp(32px, 6vw, 72px); align-items: start; }
  .portrait {
    margin: 0;
    border-radius: 18px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--line);
    position: sticky;
    top: 96px;
  }
  .portrait :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 62%; transition: transform 1.2s var(--ease); }
  .portrait:hover :global(img) { transform: scale(1.03); }
  .about-p { font-size: 17.5px; line-height: 1.75; color: var(--ink-2); max-width: 660px; }
  .about-p:first-child { font-size: 19px; color: var(--ink); }

  .mini-head {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 36px 0 14px;
  }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li {
    font-size: 14px;
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    transition: border-color 0.3s, color 0.3s, transform 0.9s var(--ease), opacity 0.9s var(--ease);
  }
  .chips li:hover { border-color: var(--accent); color: var(--accent); }

  .edu li {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }
  .edu li:last-child { border-bottom: 1px solid var(--line); }
  .edu p { margin: 0; }
  .edu-school { font-weight: 500; }
  .edu-degree { color: var(--muted); font-size: 14.5px; }
  .edu-meta { display: flex; flex-direction: column; align-items: flex-end; text-align: right; font-size: 13.5px; color: var(--muted); white-space: nowrap; font-family: var(--mono); }
  .edu-detail { color: var(--accent); }

  /* ── Shared card bits ── */
  .card-title { font-size: 18px; font-weight: 600; letter-spacing: -0.01em; line-height: 1.35; }
  .period { font-family: var(--mono); font-size: 12.5px; color: var(--muted); white-space: nowrap; margin: 0; }

  /* ── Research ── */
  .pub { padding: 28px 30px; margin-bottom: 20px; position: relative; overflow: hidden; }
  .pub::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 3px; background: var(--accent); }
  .pub-status {
    display: inline-block;
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 3px 10px;
    border-radius: 999px;
    margin-bottom: 14px;
  }
  .pub-title { font-family: var(--serif); font-size: clamp(21px, 2.4vw, 26px); line-height: 1.3; margin-bottom: 10px; }
  .pub-authors { color: var(--ink-2); margin: 0 0 2px; }
  .pub-authors :global(strong) { font-weight: 600; color: var(--ink); }
  .pub-venue { font-style: italic; font-family: var(--serif); font-size: 17px; color: var(--muted); margin: 0; }

  .research-list { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; }
  .research-status { margin-bottom: 12px; align-self: flex-start; }
  .pub-summary { color: var(--ink-2); font-size: 15.5px; margin: 14px 0 0; max-width: 820px; }
  .portrait figcaption { position: absolute; left: 10px; right: 10px; bottom: 10px; }
  .courses li { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 2px 0; }
  .grade { font-family: var(--mono); font-size: 12px; color: var(--accent); border: 1px solid var(--line); border-radius: 6px; padding: 0 6px; }
  .research { padding: 28px 30px; display: flex; flex-direction: column; }
  .research .bullets { flex: 1; margin: 6px 0 18px; max-width: 860px; }
  .research-top { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .advisor { color: var(--muted); font-size: 14px; margin: 4px 0 12px; }

  /* ── Timeline ── */
  .timeline { list-style: none; margin: 0; padding: 0 0 0 30px; position: relative; --tl: 0; }
  .timeline::before, .timeline::after {
    content: '';
    position: absolute;
    left: 5px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: var(--line);
  }
  .timeline::after { background: var(--accent); transform-origin: top; transform: scaleY(var(--tl)); }
  .tl-item { position: relative; padding-bottom: 40px; }
  .tl-item:last-child { padding-bottom: 0; }
  .tl-dot {
    position: absolute;
    left: -30px;
    top: 7px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg);
    border: 1.5px solid var(--accent);
    z-index: 1;
    transition: background-color 0.6s var(--ease) 0.3s;
  }
  .tl-item:global(.is-in) .tl-dot { background: var(--accent); }
  .tl-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 10px; }
  .org { color: var(--accent); font-weight: 600; }
  .timeline .bullets { max-width: 820px; }

  /* ── Projects ── */
  .featured { display: flex; flex-direction: column; gap: clamp(56px, 8vw, 96px); }
  .feature { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); align-items: center; }
  .feature.flip .feature-media { order: 2; }
  .feature-media {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--bg-elev);
    aspect-ratio: 4 / 3.2;
    box-shadow: var(--shadow);
  }
  .feature-media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.4s var(--ease); }
  .feature:hover .feature-media :global(img) { transform: scale(1.045); }
