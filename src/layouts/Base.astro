---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { profile } from '../data/content';

interface Props { title?: string; description?: string }
const { title = profile.name, description = `${profile.name}. ${profile.tagline}` } = Astro.props;

const nav = [
  { href: '#about', label: 'About' },
  { href: '#work', label: 'Work' },
  { href: '#academics', label: 'Academics' },
  { href: '#cv', label: 'CV' },
  { href: '#contact', label: 'Contact' },
];
const canonical = new URL(Astro.url.pathname, Astro.site);
// On project pages, section links must point back to the home page
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
const here = (hash: string) => (isHome ? hash : '/' + hash);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#f6f5f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1114" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap"
    />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="progress" aria-hidden="true"></div>

    <header class="site-header">
      <div class="pill">
        <a href={isHome ? '#top' : '/'} class="brand" aria-label={isHome ? 'Back to top' : 'Home'}>S</a>
        <span class="sep" aria-hidden="true"></span>
        <nav class="nav-links" aria-label="Sections">
          <span class="glide" aria-hidden="true"></span>
          {nav.map((n) => <a href={here(n.href)} class:list={[{ 'nav-cv': n.href === '#cv' }]}>{n.label}</a>)}
        </nav>
        <span class="sep" aria-hidden="true"></span>
        <button class="theme-toggle" type="button" aria-label="Toggle dark mode">
          <span class="i-sun"><Icon name="sun" size={16} /></span>
          <span class="i-moon"><Icon name="moon" size={16} /></span>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container foot">
        <span>© {new Date().getFullYear()} {profile.name}</span>
        <span class="foot-links">
          <a class="link" href={`mailto:${profile.email}`}>Email</a>
          <a class="link" href={profile.links.github} target="_blank" rel="noopener">GitHub</a>
          <a class="link" href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        </span>
      </div>
    </footer>

    <script>
      import '../scripts/motion';

      /* theme toggle */
      const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const isDark =
          root.dataset.theme === 'dark' ||
          (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
        const next = isDark ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });

      /* gliding highlight behind the nav links */
      const navEl = document.querySelector<HTMLElement>('.nav-links');
      const glide = document.querySelector<HTMLElement>('.glide');
      if (navEl && glide) {
        const links = Array.from(navEl.querySelectorAll<HTMLAnchorElement>('a'));
        const moveTo = (a: HTMLElement | null | undefined) => {
          if (!a) { glide.style.opacity = '0'; return; }
          glide.style.opacity = '1';
          glide.style.width = `${a.offsetWidth}px`;
          glide.style.transform = `translateX(${a.offsetLeft}px)`;
        };
        const active = () => links.find((l) => l.classList.contains('is-active'));
        links.forEach((l) => l.addEventListener('mouseenter', () => moveTo(l)));
        navEl.addEventListener('mouseleave', () => moveTo(active()));
        new MutationObserver(() => { if (!navEl.matches(':hover')) moveTo(active()); })
          .observe(navEl, { subtree: true, attributes: true, attributeFilter: ['class'] });
        window.addEventListener('resize', () => moveTo(active()));
        document.fonts?.ready.then(() => moveTo(active()));
      }
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 8px;
    z-index: 100;
    background: var(--ink);
    color: var(--bg);
    padding: 8px 14px;
    border-radius: 8px;
  }
  .skip:focus { left: 8px; }

  .progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 2px;
    background: var(--accent);
    transform-origin: 0 50%;
    transform: scaleX(0);
    z-index: 60;
  }

  /* ── Floating capsule nav ── */
  .site-header {
    position: fixed;
    top: 16px;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding: 0 12px;
    pointer-events: none;
    transition: transform 0.6s var(--ease), opacity 0.4s;
    animation: drop-in 0.9s var(--ease) 0.2s backwards;
  }
  @keyframes drop-in { from { opacity: 0; transform: translateY(-24px); } }
  .site-header:global(.is-hidden) { transform: translateY(-140%); }

  .pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg-elev) 72%, transparent);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 10px 30px rgba(0, 0, 0, 0.08);
    max-width: 100%;
    transition: box-shadow 0.4s, border-color 0.4s;
  }
  .site-header:global(.is-scrolled) .pill { border-color: var(--line-strong); box-shadow: var(--shadow-hover); }

  .brand {
    flex: none;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
    font-family: var(--serif);
    font-size: 18px;
    line-height: 1;
    transition: background-color 0.4s, transform 0.6s var(--ease);
  }
  .brand:hover { background: var(--accent); transform: rotate(-12deg) scale(1.05); }

  .sep { flex: none; width: 1px; height: 18px; background: var(--line-strong); margin: 0 4px; }

  .nav-links { position: relative; display: flex; align-items: center; gap: 2px; overflow-x: auto; scrollbar-width: none; }
  .nav-links::-webkit-scrollbar { display: none; }
  .nav-links a {
    position: relative;
    z-index: 1;
    flex: none;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--muted);
    padding: 8px 14px;
    border-radius: 999px;
    transition: color 0.3s;
  }
  .nav-links a:hover, .nav-links a:global(.is-active) { color: var(--ink); }
  .glide {
    position: absolute;
    left: 0;
    top: 50%;
    height: 34px;
    margin-top: -17px;
    width: 0;
    border-radius: 999px;
    background: var(--accent-soft);
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    opacity: 0;
    transition: transform 0.5s var(--ease), width 0.5s var(--ease), opacity 0.3s;
    pointer-events: none;
  }

  .theme-toggle {
    flex: none;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: 0;
    background: transparent;
    color: var(--ink-2);
    border-radius: 50%;
    cursor: pointer;
    transition: color 0.3s, background-color 0.3s, transform 0.5s var(--ease);
  }
  .theme-toggle:hover { color: var(--accent); background: var(--accent-soft); transform: rotate(20deg); }
  .theme-toggle span { display: grid; place-items: center; }
  .i-moon { display: none !important; }
  :global(:root[data-theme='dark']) .i-sun { display: none !important; }
  :global(:root[data-theme='dark']) .i-moon { display: grid !important; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .i-sun { display: none !important; }
    :global(:root:not([data-theme='light'])) .i-moon { display: grid !important; }
  }

  .site-footer { margin-top: 96px; border-top: 1px solid var(--line); }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding-top: 28px;
    padding-bottom: 36px;
    font-size: 13.5px;
    color: var(--muted);
  }
  .foot-links { display: flex; gap: 18px; }

  @media (max-width: 480px) {
    .site-header { top: 10px; padding: 0 8px; }
    .nav-links a { padding: 7px 10px; font-size: 13px; }
    .sep { margin: 0 2px; }
    .nav-links a.nav-cv { display: none; }
  }
  @media (max-width: 400px) {
    .sep { display: none; }
    .pill { gap: 2px; padding: 5px; }
    .nav-links a { padding: 7px 8px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header { animation: none; }
  }
</style>
