---
// Four tanpura-like strings across the top of the page.
// They pluck themselves in a slow tanpura cycle (Pa–Sa–Sa–Sa) and can be
// plucked by brushing across them with the mouse or a finger.
---
<canvas class="strings" aria-hidden="true"></canvas>

<style>
  .strings {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    opacity: 0;
    transition: opacity 2s ease;
  }
  .strings:global(.is-ready) { opacity: 1; }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('canvas.strings');
  const host = canvas?.parentElement;
  if (canvas && host) init(canvas, host);

  function init(canvas: HTMLCanvasElement, host: HTMLElement) {
    const ctx = canvas.getContext('2d')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const N = 140; // points per string
    const C2 = 0.24; // wave speed² (stable < 1)
    const DAMP = 0.009; // energy loss per step
    const STRINGS = 4;

    type Str = { y: number; cur: Float32Array; prev: Float32Array; glow: number };
    let strings: Str[] = [];
    let W = 0, H = 0, dpr = 1;
    let colors = { ink: '#15171c', accent: '#b0532b', dark: false };

    function hexToRgb(hex: string) {
      const h = hex.trim().replace('#', '');
      const n = parseInt(h.length === 3 ? h.split('').map((c) => c + c).join('') : h, 16);
      return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
    }
    function readColors() {
      const cs = getComputedStyle(document.documentElement);
      const bg = cs.getPropertyValue('--bg').trim();
      const [r, g, b] = bg.startsWith('#') ? hexToRgb(bg) : [255, 255, 255];
      colors = {
        ink: cs.getPropertyValue('--ink').trim() || '#15171c',
        accent: cs.getPropertyValue('--accent').trim() || '#b0532b',
        dark: (0.299 * r + 0.587 * g + 0.114 * b) / 255 < 0.3,
      };
    }
    const rgba = (hex: string, a: number) => {
      const [r, g, b] = hexToRgb(hex);
      return `rgba(${r},${g},${b},${a})`;
    };

    function layout() {
      const rect = host.getBoundingClientRect();
      W = Math.max(1, Math.round(rect.width));
      H = Math.max(1, Math.round(rect.height));
      dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      const top = H * 0.2, bottom = H * 0.86;
      strings = Array.from({ length: STRINGS }, (_, i) => ({
        y: top + ((bottom - top) * i) / (STRINGS - 1),
        cur: new Float32Array(N),
        prev: new Float32Array(N),
        glow: 0,
      }));
    }

    /* pluck: a soft velocity impulse centred at x */
    function pluck(s: Str, x: number, amp: number) {
      const k = (x / W) * (N - 1);
      const w = Math.max(4, N * 0.05);
      for (let i = 1; i < N - 1; i++) {
        const g = Math.exp(-(((i - k) / w) ** 2));
        s.prev[i] -= amp * g;
      }
      s.glow = Math.min(1, s.glow + Math.abs(amp) / 2);
    }

    function step() {
      for (const s of strings) {
        const { cur, prev } = s;
        const next = prev; // reuse buffer
        let energy = 0;
        for (let i = 1; i < N - 1; i++) {
          const lap = cur[i - 1] - 2 * cur[i] + cur[i + 1];
          const v = (2 - DAMP) * cur[i] - (1 - DAMP) * prev[i] + C2 * lap;
          next[i] = v;
          energy = Math.max(energy, Math.abs(v));
        }
        s.prev = cur;
        s.cur = next;
        s.glow = Math.max(s.glow * 0.975, Math.min(1, energy / 7));
      }
    }

    function draw() {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);
      ctx.lineCap = 'round';
      const base = colors.dark ? 0.16 : 0.13;
      for (const s of strings) {
        const path = new Path2D();
        for (let i = 0; i < N; i++) {
          const x = (i / (N - 1)) * W;
          const y = s.y + s.cur[i];
          if (i === 0) path.moveTo(x, y);
          else path.lineTo(x, y);
        }
        ctx.strokeStyle = rgba(colors.ink, base);
        ctx.lineWidth = 1;
        ctx.stroke(path);
        if (s.glow > 0.01) {
          ctx.globalCompositeOperation = colors.dark ? 'lighter' : 'source-over';
          ctx.strokeStyle = rgba(colors.accent, 0.18 * s.glow);
          ctx.lineWidth = 5;
          ctx.stroke(path);
          ctx.strokeStyle = rgba(colors.accent, 0.85 * s.glow);
          ctx.lineWidth = 1.3;
          ctx.stroke(path);
          ctx.globalCompositeOperation = 'source-over';
        }
      }
    }

    /* tanpura cycle: Pa, Sa, Sa, (low) Sa — plucked one after another */
    const ORDER = [0, 1, 2, 3];
    let cycle = 0;
    let nextAuto = 0;
    function autoPluck(now: number) {
      if (now < nextAuto) return;
      const idx = ORDER[cycle % ORDER.length];
      const s = strings[idx];
      if (s) pluck(s, W * (0.28 + Math.random() * 0.06), W < 700 ? 0.3 : 0.38);
      cycle++;
      nextAuto = now + (cycle % ORDER.length === 0 ? 1900 : 950);
    }

    /* pointer: pluck strings you cross */
    let lastY: number | null = null;
    let lastX = 0;
    function crossing(x: number, y: number) {
      const r = canvas.getBoundingClientRect();
      x -= r.left;
      y -= r.top;
      if (lastY !== null) {
        const dy = y - lastY;
        for (const s of strings) {
          if ((lastY - s.y) * (y - s.y) < 0) {
            const speed = Math.hypot(x - lastX, dy);
            pluck(s, x, Math.min(1.5, 0.35 + speed * 0.025) * Math.sign(dy || 1));
          }
        }
      }
      lastY = y;
      lastX = x;
    }
    host.addEventListener('pointermove', (e) => { if (e.pointerType === 'mouse') crossing(e.clientX, e.clientY); });
    host.addEventListener('pointerleave', () => { lastY = null; });
    host.addEventListener('touchstart', (e) => { lastY = null; crossing(e.touches[0].clientX, e.touches[0].clientY); }, { passive: true });
    host.addEventListener('touchmove', (e) => crossing(e.touches[0].clientX, e.touches[0].clientY), { passive: true });
    host.addEventListener('touchend', () => { lastY = null; }, { passive: true });
    host.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('a, button')) return;
      const r = canvas.getBoundingClientRect();
      const y = e.clientY - r.top;
      let best = strings[0], d = Infinity;
      for (const s of strings) if (Math.abs(s.y - y) < d) { d = Math.abs(s.y - y); best = s; }
      if (best && d < 60) pluck(best, e.clientX - r.left, 1.2);
    });

    /* loop */
    let running = false, raf = 0;
    function frame(now: number) {
      raf = 0;
      if (!running) return;
      autoPluck(now);
      step();
      step();
      draw();
      raf = requestAnimationFrame(frame);
    }
    function setRunning(on: boolean) {
      running = on && !reduce;
      if (running && !raf) raf = requestAnimationFrame(frame);
    }

    let visible = true;
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; setRunning(visible && !document.hidden); }).observe(host);
    document.addEventListener('visibilitychange', () => setRunning(visible && !document.hidden));

    let lastW = 0, t = 0;
    new ResizeObserver(() => {
      const w = Math.round(host.getBoundingClientRect().width);
      if (w === lastW && W) return;
      lastW = w;
      clearTimeout(t);
      t = window.setTimeout(() => { layout(); draw(); }, 120);
    }).observe(host);

    const recolor = () => { readColors(); draw(); };
    new MutationObserver(recolor).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', recolor);

    readColors();
    layout();
    draw();
    canvas.classList.add('is-ready');
    nextAuto = performance.now() + 1400; // first pluck after the name has appeared
    setRunning(true);
  }
</script>
